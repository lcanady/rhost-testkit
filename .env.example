# RhostMUSH server settings
RHOST_PORT=4201
RHOST_MUD_NAME=RhostMUSH
RHOST_API_PORT=4202
RHOST_PASS=Nyctasia

# Directory (relative to docker-compose.yml) where persistent game files are written.
# Includes: data/, txt/, netrhost.conf, mush.config
# Defaults to ./persistent_data if unset.
RHOST_DATA_DIR=./persistent_data

# PostgreSQL credentials (used by jobs_db.py and docker-compose)
PGUSER=mush
PGPASSWORD=mushpass
PGDATABASE=jobs

# ── stunnel TLS wrapper (optional) ───────────────────────────────────────────
# Set STUNNEL_ENABLE=true to wrap the MUSH port in TLS via stunnel.
# Required when clients connect via wss:// or from an https:// page.
#
# STUNNEL_ENABLE=true
# STUNNEL_ACCEPT_PORT=4203      # port stunnel listens on (default: 4203)
# STUNNEL_CONNECT_PORT=4201     # port stunnel forwards to (default: RHOST_PORT)
# STUNNEL_CERT=/path/to/cert.pem   # PEM cert (auto-generated self-signed if omitted)
# STUNNEL_KEY=/path/to/key.pem     # PEM key  (defaults to STUNNEL_CERT if omitted)
